[
  {
    "fields": [
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "description": "The name as it should appear on the invitation search (e.g., \"John Smith\")",
        "name": "name",
        "type": "string",
        "title": "Full Name"
      },
      {
        "options": {
          "source": "name",
          "maxLength": 96
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "description": "The unique URL part for this guest. Click \"Generate\" after entering the name.",
        "name": "slug",
        "type": "slug",
        "title": "URL Slug"
      },
      {
        "initialValue": 1,
        "description": "Total number of seats allocated to this guest/party",
        "name": "seats_reserved",
        "type": "number"
      },
      {
        "name": "table_number",
        "type": "number"
      },
      {
        "initialValue": false,
        "name": "hasResponded",
        "type": "boolean",
        "title": "Has Responded?"
      },
      {
        "options": {
          "list": [
            {
              "title": "Attending",
              "value": "attending"
            },
            {
              "title": "Declined",
              "value": "declined"
            }
          ]
        },
        "name": "RSVP_status",
        "type": "string"
      },
      {
        "name": "attending_count",
        "type": "number"
      },
      {
        "description": "Optional: Override the default timeline for this specific guest",
        "of": [
          {
            "fields": [
              {
                "name": "time",
                "type": "string"
              },
              {
                "name": "event",
                "type": "string"
              }
            ],
            "type": "object"
          }
        ],
        "name": "timeline",
        "type": "array",
        "title": "Personalized Timeline"
      }
    ],
    "name": "guest",
    "type": "document",
    "title": "Guest List"
  },
  {
    "fields": [
      {
        "description": "Upload MP3 files for the background music playlist.",
        "of": [
          {
            "options": {
              "accept": "audio/*"
            },
            "type": "file"
          }
        ],
        "name": "backgroundMusic",
        "type": "array"
      },
      {
        "initialValue": "2026-07-04T15:00:00Z",
        "description": "The official date and time of the ceremony for the countdown timer and display text.",
        "name": "weddingDate",
        "type": "datetime",
        "title": "Wedding Date & Time"
      },
      {
        "options": {
          "accept": "video/*"
        },
        "description": "Upload a personalized video message for guests who accept the invitation.",
        "name": "thankYouVideo",
        "type": "file"
      },
      {
        "name": "venueName",
        "type": "string"
      },
      {
        "name": "venueAddress",
        "type": "string"
      },
      {
        "description": "e.g., Ceremony begins at 3:00 PM",
        "name": "venueDetails",
        "type": "string"
      },
      {
        "name": "attireDescription",
        "type": "text"
      },
      {
        "name": "giftingDescription",
        "type": "text"
      },
      {
        "options": {
          "accept": ".glb"
        },
        "description": "3D model for the top left corner.",
        "name": "roseModelTopLeft",
        "type": "file",
        "title": "Top Left Rose Model (.glb)"
      },
      {
        "options": {
          "accept": ".glb"
        },
        "description": "3D model for the top right corner.",
        "name": "roseModelTopRight",
        "type": "file",
        "title": "Top Right Rose Model (.glb)"
      },
      {
        "options": {
          "accept": ".glb"
        },
        "description": "3D model for the bottom left corner.",
        "name": "roseModelBottomLeft",
        "type": "file",
        "title": "Bottom Left Rose Model (.glb)"
      },
      {
        "options": {
          "accept": ".glb"
        },
        "description": "3D model for the bottom right corner.",
        "name": "roseModelBottomRight",
        "type": "file",
        "title": "Bottom Right Rose Model (.glb)"
      },
      {
        "of": [
          {
            "fields": [
              {
                "name": "time",
                "type": "string"
              },
              {
                "name": "event",
                "type": "string"
              }
            ],
            "type": "object"
          }
        ],
        "name": "timeline",
        "type": "array",
        "title": "Global Timeline"
      }
    ],
    "name": "eventSettings",
    "type": "document"
  },
  {
    "fields": [
      {
        "description": "Name of the guest who left the wish.",
        "readOnly": true,
        "name": "guestName",
        "type": "string"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "min",
                "constraint": 10
              },
              {
                "flag": "max",
                "constraint": 500
              }
            ]
          }
        ],
        "description": "The wish or message left by the guest.",
        "name": "message",
        "type": "text"
      },
      {
        "options": {
          "dateFormat": "YYYY-MM-DDTHH:mm:ssZ"
        },
        "readOnly": true,
        "name": "createdAt",
        "type": "datetime"
      }
    ],
    "name": "wish",
    "type": "document",
    "title": "Guest Wishes"
  }
]